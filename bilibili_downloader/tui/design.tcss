/* BiliFlow TUI — Indigo design (dark baseline).
   Global styles. Per-widget styles live in each widget's DEFAULT_CSS.
   Hex values mirror gui/resources/styles.py exactly. */

Screen, App {
    background: #0d0d0f;
    color: #e8e8ec;
}

.primary { background: #6366f1; color: #ffffff; border: solid #7c7ff5; }

MainScreen { height: 1fr; }
#workspace-shell { height: 1fr; width: 1fr; }
#workspace-main { height: 1fr; width: 1fr; }
#background-status {
    width: 1fr;
    height: 3;
    background: #173b3b;
    color: #e8e8ec;
}

/* The queue fills the task workspace. */
DownloadQueue {
    height: 1fr;
    min-height: 3;
    background: #161619;
    border-top: solid #26262b;
    padding: 0 1;
}
DownloadQueue > .datatable--header { background: #121214; color: #6b6b75; }
DownloadQueue > .datatable--cursor { background: #173b3b; color: #e8e8ec; }
